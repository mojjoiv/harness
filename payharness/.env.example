# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/payharness

# Authentication / application
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NODE_ENV=development

# Credential encryption (base64-encoded 32-byte key)
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Gmail / mailer
GMAIL_CLIENT_ID=replace-with-gmail-client-id
GMAIL_CLIENT_SECRET=replace-with-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback
GMAIL_REFRESH_TOKEN=replace-with-gmail-refresh-token

# Optional deployment/runtime metadata
GIT_COMMIT_SHA=local
RENDER_SERVICE_NAME=payharness-api
