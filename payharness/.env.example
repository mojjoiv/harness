# Runtime
NODE_ENV=development
NODE_VERSION=16.20.2
PORT=3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/payharness

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Credential encryption: base64-encoded 32-byte key
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Application URLs
APP_URL=http://localhost:3000
CHECKOUT_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# Platform bootstrap (development only)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=PayHarness
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# M-Pesa verification smoke test
ENABLE_MPESA_SMOKE_TEST=false

# Optional runtime metadata
GIT_COMMIT_SHA=local
RENDER_SERVICE_NAME=payharness-api
