# Runtime
NODE_ENV=development
PORT=3000
API_PORT=3000
DASHBOARD_PORT=3001

# Local PostgreSQL (used by Docker Compose defaults)
POSTGRES_DB=payharness
POSTGRES_USER=payharness
POSTGRES_PASSWORD=payharness
POSTGRES_PORT=5432

# Database
# Leave blank for Docker Compose to use the local PostgreSQL service.
# For a host-installed/hosted database, set the full PostgreSQL URL here.
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Credential encryption: base64-encoded 32-byte key
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Application URLs
APP_URL=http://localhost:3000
CHECKOUT_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# Integration package runtime directory
# Production Docker default: /app/integrations
PAYHARNESS_INTEGRATIONS_PATH=/app/integrations

# Platform bootstrap (development only)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Admin

# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=PayHarness
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# M-Pesa verification smoke test
ENABLE_MPESA_SMOKE_TEST=false

# Optional runtime metadata
GIT_COMMIT_SHA=local
RENDER_SERVICE_NAME=payharness-api

# Distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_REDIS_PREFIX=payharness:ratelimit

# Fraud risk engine thresholds
FRAUD_RISK_WINDOW_MINUTES=10
FRAUD_RISK_REVIEW_SCORE=40
FRAUD_RISK_BLOCK_SCORE=70
FRAUD_RISK_HIGH_VALUE_CENTS=1000000
FRAUD_RISK_VERY_HIGH_VALUE_CENTS=5000000
