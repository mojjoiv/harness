# Local Docker development defaults. Never put real secrets here.
NODE_ENV=development
NODE_VERSION=20.11.1
PORT=3000

# PostgreSQL (Docker Compose)
POSTGRES_DB=payharness
POSTGRES_USER=payharness
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/payharness

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Credential encryption: replace with a base64-encoded 32-byte key.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Application URLs
APP_URL=http://localhost:3000
CHECKOUT_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# Platform bootstrap (development only)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# Gmail API (optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=PayHarness
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# M-Pesa verification smoke test (optional; never enables LIVE smoke tests)
ENABLE_MPESA_SMOKE_TEST=false

# Optional runtime metadata
GIT_COMMIT_SHA=local
RENDER_SERVICE_NAME=payharness-api
