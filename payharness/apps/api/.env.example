CREDENTIAL_ENCRYPTION_KEY=

APP_URL=http://localhost:3000
CHECKOUT_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# Outgoing email (Gmail API over HTTPS, not SMTP -- see scripts/generate-gmail-refresh-token.ts)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=PayHarness

NODE_VERSION=16.20.2
