NODE_ENV=development
PORT=3000
DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

APP_URL=http://localhost:3000
CHECKOUT_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Admin

# Outgoing email via Gmail API over HTTPS.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=PayHarness

# Optional sandbox M-Pesa verification smoke test. Never enables LIVE smoke tests.
ENABLE_MPESA_SMOKE_TEST=false
