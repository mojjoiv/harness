generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum PlatformRole {
  SUPERADMIN
  PLATFORM_ADMIN
  SUPPORT
  FINANCE
  COMPLIANCE
}

enum PlatformUserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PlanStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum Environment {
  SANDBOX
  LIVE
}

enum Provider {
  MPESA
  STRIPE
  PAYPAL
}

enum Status {
  ACTIVE
  INACTIVE
  REVOKED
  PENDING
  FAILED
  SUCCEEDED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
}

enum TransactionType {
  PAYMENT
  REFUND
  FEE
  PAYOUT
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  merchantUsers MerchantUser[]
  auditLogs     AuditLog[]

  @@map("users")
}

model PlatformUser {
  id        String             @id @default(uuid())
  email     String             @unique
  password  String
  name      String
  role      PlatformRole
  status    PlatformUserStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  lastLogin DateTime?          @map("last_login")

  @@map("platform_users")
}

model Merchant {
  id                  String                 @id @default(uuid())
  name                String
  slug                String                 @unique
  status              MerchantStatus         @default(PENDING)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  profile             MerchantProfile?
  branding            MerchantBranding?
  settings            MerchantSettings?
  users               MerchantUser[]
  apiKeys             ApiKey[]
  providerCredentials ProviderCredential[]
  providerVerificationLogs ProviderVerificationLog[]
  checkoutSessions    CheckoutSession[]
  payments            Payment[]
  transactions        Transaction[]
  webhookEndpoints    WebhookEndpoint[]
  customers           Customer[]
  subscriptions       MerchantSubscription[]
  auditLogs           AuditLog[]
  apiUsage            ApiUsage[]

  @@map("merchants")
}

model MerchantProfile {
  id                  String   @id @default(uuid())
  merchantId          String   @unique @map("merchant_id")
  businessName        String?  @map("business_name")
  legalName           String?  @map("legal_name")
  registrationNumber  String?  @map("registration_number")
  taxPin              String?  @map("tax_pin")
  country             String?
  currency            String?
  timezone            String?
  supportEmail        String?  @map("support_email")
  supportPhone        String?  @map("support_phone")
  website             String?
  logoUrl             String?  @map("logo_url")
  primaryBrandColor   String?  @map("primary_brand_color")
  secondaryBrandColor String?  @map("secondary_brand_color")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  merchant            Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_profiles")
}

model MerchantBranding {
  id                 String   @id @default(uuid())
  merchantId         String   @unique @map("merchant_id")
  logoUrl            String?  @map("logo_url")
  faviconUrl         String?  @map("favicon_url")
  primaryColor       String   @default("#2563eb") @map("primary_color")
  secondaryColor     String   @default("#0f172a") @map("secondary_color")
  buttonColor        String   @default("#2563eb") @map("button_color")
  successPageMessage String?  @map("success_page_message")
  cancelPageMessage  String?  @map("cancel_page_message")
  receiptFooter      String?  @map("receipt_footer")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  merchant           Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_branding")
}

model MerchantSettings {
  id                    String      @id @default(uuid())
  merchantId            String      @unique @map("merchant_id")
  defaultCurrency       String      @default("KES") @map("default_currency")
  defaultEnvironment    Environment @default(SANDBOX) @map("default_environment")
  receiptEmailsEnabled  Boolean     @default(true) @map("receipt_emails_enabled")
  webhookRetriesEnabled Boolean     @default(true) @map("webhook_retries_enabled")
  retryCount            Int         @default(3) @map("retry_count")
  paymentTimeoutMinutes Int         @default(30) @map("payment_timeout_minutes")
  requireCustomerEmail  Boolean     @default(false) @map("require_customer_email")
  requireCustomerPhone  Boolean     @default(false) @map("require_customer_phone")
  successUrl            String?     @map("success_url")
  cancelUrl             String?     @map("cancel_url")
  webhookForwardingUrl  String?     @map("webhook_forwarding_url")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  merchant              Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_settings")
}

enum MerchantUserStatus {
  ACTIVE
  DEACTIVATED
}

model MerchantUser {
  id         String             @id @default(uuid())
  merchantId String             @map("merchant_id")
  userId     String             @map("user_id")
  role       UserRole           @default(OWNER)
  status     MerchantUserStatus @default(ACTIVE)
  createdAt  DateTime           @default(now()) @map("created_at")
  merchant   Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@map("merchant_users")
}

model SubscriptionPlan {
  id                String                 @id @default(uuid())
  name              String
  code              String                 @unique
  priceCents        Int                    @map("price_cents")
  annualPriceCents  Int?                   @map("annual_price_cents")
  currency          String                 @default("USD")
  apiRequestLimit   Int?                   @map("api_request_limit")
  transactionLimit  Int?                   @map("transaction_limit")
  userLimit         Int?                   @map("user_limit")
  storageLimitMb    Int?                   @map("storage_limit_mb")
  webhookLimit      Int?                   @map("webhook_limit")
  allowedProviders  Provider[]             @default([]) @map("allowed_providers")
  status            PlanStatus             @default(ACTIVE)
  features          Json                   @default("{}")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  subscriptions     MerchantSubscription[]

  @@map("subscription_plans")
}

model MerchantSubscription {
  id         String           @id @default(uuid())
  merchantId String           @map("merchant_id")
  planId     String           @map("plan_id")
  status     Status           @default(ACTIVE)
  startedAt  DateTime         @default(now()) @map("started_at")
  endsAt     DateTime?        @map("ends_at")
  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("merchant_subscriptions")
}

model ApiKey {
  id         String      @id @default(uuid())
  merchantId String      @map("merchant_id")
  name       String
  prefix     String
  keyHash    String      @map("key_hash")
  environment Environment
  status     Status      @default(ACTIVE)
  lastUsedAt DateTime?   @map("last_used_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  revokedAt  DateTime?   @map("revoked_at")
  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  apiUsage   ApiUsage[]

  @@map("api_keys")
}

enum ProviderVerificationStatus {
  PENDING
  VERIFIED
  PARTIALLY_VERIFIED
  FAILED
}

model ProviderCredential {
  id                       String                     @id @default(uuid())
  merchantId               String                     @map("merchant_id")
  provider                 Provider
  environment              Environment
  label                    String                     @default("default")
  publicConfig             Json                       @default("{}") @map("public_config")
  encryptedSecretConfig    Json                       @map("encrypted_secret_config")
  status                   Status                     @default(ACTIVE)
  isDefault                Boolean                    @default(false) @map("is_default")
  verificationStatus       ProviderVerificationStatus @default(PENDING) @map("verification_status")
  oauthVerified            Boolean                    @default(false) @map("oauth_verified")
  accountVerified          Boolean                    @default(false) @map("account_verified")
  webhookVerified          Boolean                    @default(false) @map("webhook_verified")
  environmentVerified      Boolean                    @default(false) @map("environment_verified")
  verificationLatencyMs    Int?                       @map("verification_latency_ms")
  verificationWarnings     Json                       @default("[]") @map("verification_warnings")
  verificationErrors       Json                       @default("[]") @map("verification_errors")
  lastVerifiedAt           DateTime?                  @map("last_verified_at")
  lastVerificationError    String?                    @map("last_verification_error")
  failedVerificationCount  Int                        @default(0) @map("failed_verification_count")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  merchant                 Merchant                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, provider, environment, label])
  @@map("provider_credentials")
}

model ProviderVerificationLog {
  id             String      @id @default(uuid())
  merchantId     String      @map("merchant_id")
  credentialId   String      @map("credential_id")
  provider       Provider
  environment    Environment
  success        Boolean
  responseTimeMs Int?        @map("response_time_ms")
  httpStatus     Int?        @map("http_status")
  oauthSucceeded Boolean?    @map("oauth_succeeded")
  failureReason  String?     @map("failure_reason")
  warnings       Json        @default("[]")
  errors         Json        @default("[]")
  createdAt      DateTime    @default(now()) @map("created_at")
  merchant       Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([credentialId, createdAt])
  @@map("provider_verification_logs")
}

model PlatformGatewayConfig {
  id        String   @id @default(uuid())
  provider  Provider @unique
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_gateway_configs")
}

model ProviderCountryAvailability {
  id          String   @id @default(uuid())
  provider    Provider
  countryCode String   @map("country_code")
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([provider, countryCode])
  @@map("provider_country_availability")
}

model Customer {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  email      String?
  name       String?
  phone      String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  checkoutSessions CheckoutSession[]
  payments   Payment[]

  @@map("customers")
}

model CheckoutSession {
  id          String        @id @default(uuid())
  merchantId  String        @map("merchant_id")
  customerId  String?       @map("customer_id")
  amountCents Int           @map("amount_cents")
  currency    String
  status      PaymentStatus @default(PENDING)
  successUrl  String        @map("success_url")
  cancelUrl   String        @map("cancel_url")
  allowedProviders Provider[] @default([]) @map("allowed_providers")
  metadata    Json          @default("{}")
  expiresAt   DateTime      @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  merchant    Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer    Customer?     @relation(fields: [customerId], references: [id])
  payments    Payment[]

  @@map("checkout_sessions")
}

model Payment {
  id                String           @id @default(uuid())
  merchantId        String           @map("merchant_id")
  customerId        String?          @map("customer_id")
  checkoutSessionId String?          @map("checkout_session_id")
  provider          Provider
  environment       Environment      @default(SANDBOX)
  amountCents       Int              @map("amount_cents")
  currency          String
  status            PaymentStatus    @default(PENDING)
  providerReference String?          @map("provider_reference")
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  merchant          Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer          Customer?        @relation(fields: [customerId], references: [id])
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])
  transactions      Transaction[]

  @@map("payments")
}

model Transaction {
  id          String          @id @default(uuid())
  merchantId  String          @map("merchant_id")
  paymentId   String?         @map("payment_id")
  type        TransactionType
  amountCents Int             @map("amount_cents")
  currency    String
  status      PaymentStatus   @default(PENDING)
  reference   String?
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at")
  merchant    Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment     Payment?        @relation(fields: [paymentId], references: [id])

  @@map("transactions")
}

model WebhookEndpoint {
  id         String             @id @default(uuid())
  merchantId String             @map("merchant_id")
  url        String
  events     String[]
  secretHash String             @map("secret_hash")
  status     Status             @default(ACTIVE)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  merchant   Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String           @id @default(uuid())
  webhookEndpointId String?          @map("webhook_endpoint_id")
  provider          Provider?
  eventType         String           @map("event_type")
  payload           Json
  status            Status           @default(PENDING)
  attempts          Int              @default(0)
  responseCode      Int?             @map("response_code")
  responseBody      String?          @map("response_body")
  createdAt         DateTime         @default(now()) @map("created_at")
  deliveredAt       DateTime?        @map("delivered_at")
  endpoint          WebhookEndpoint? @relation(fields: [webhookEndpointId], references: [id])

  @@map("webhook_deliveries")
}

model AuditLog {
  id         String    @id @default(uuid())
  merchantId String?   @map("merchant_id")
  userId     String?   @map("user_id")
  action     String
  entity     String
  entityId   String?   @map("entity_id")
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at")
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ApiUsage {
  id             String   @id @default(uuid())
  merchantId     String   @map("merchant_id")
  apiKeyId       String?  @map("api_key_id")
  endpoint       String
  method         String
  statusCode     Int      @map("status_code")
  responseTimeMs Int      @map("response_time_ms")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  apiKey         ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt])
  @@map("api_usage")
}
